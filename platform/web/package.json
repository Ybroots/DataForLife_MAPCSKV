{
  "name": "@cskv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build && node scripts/verify-map-worker.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p test/tsconfig.json --pretty false",
    "build:android": "tsc -b && vite build --mode android && node scripts/verify-map-worker.mjs dist-android && node scripts/verify-citizen-bundle.mjs",
    "build:android:qa": "tsc -b && vite build --mode android-qa && node scripts/verify-map-worker.mjs dist-android && node scripts/verify-citizen-bundle.mjs",
    "android:sync": "cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "lucide-react": "1.34.0",
    "maplibre-gl": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
