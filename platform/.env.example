# PostgreSQL/PostGIS used by the API and migration runner.
DATABASE_URL=postgresql://cskv:cskv_local@localhost:5434/cskv
API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
API_OFFICER_SESSION_SECRET=replace-with-at-least-32-random-characters
API_OFFICER_USERNAME=cskv.xuanhuong
API_OFFICER_PASSWORD=replace-this-local-officer-password
API_CITIZEN_SESSION_SECRET=replace-with-a-different-32-character-secret
API_CITIZEN_USERNAME=0912345678
API_CITIZEN_PASSWORD=replace-this-local-citizen-password
API_CITIZEN_ID=citizen-xuan-huong-pilot
API_CITIZEN_DISPLAY_NAME=Người dân Xuân Hương

# Use "postgres" outside tests. "fixture" is only for local UI/e2e verification.
API_DATA_SOURCE=postgres

# Public Firebase client configuration used only by the read-only migration tool.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional overrides.
FIRESTORE_CONTACTS_COLLECTION=contacts
FIRESTORE_COMMUNES_COLLECTION=communes
MAP_GEOJSON_PATH=../../map34.json
VITE_API_BASE_URL=http://localhost:3001

# Optional map assistant. Disabled until provider, model and matching server-only key are set.
# Choose exactly one provider: openai or gemini. Never use VITE_ for secrets.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Global cap per API process/day (UTC). Also limited to 6 queries/minute/IP and 3 concurrent calls.
AI_DAILY_REQUEST_LIMIT=200

# Optional push notifications (FCM). Disabled until the service-account key file is set.
# The key file is a SECRET: keep it outside the repository, readable only by the API user (chmod 600).
# See docs/push-notifications.md.
FCM_SERVICE_ACCOUNT_FILE=
# Milliseconds between sweeps for new alerts and case updates.
PUSH_POLL_INTERVAL_MS=15000
